# ── Core (existing) ──────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:your_password@localhost/sih_ps26132
AGMARKNET_API_KEY=your_agmarknet_api_key_here
SECRET_KEY=your_secret_key_here
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
FORCE_HTTPS=false
ENVIRONMENT=development

# ── OTP / SMS (Phase 6.4) ───────────────────────────────────────────
# Sign up at https://2factor.in/ — get API key from dashboard
# You MUST register an SMS template via DLT (TRAI requirement) before
# transactional SMS will actually deliver on Indian networks.
SMS_API_KEY=your_2factor_api_key_here

# ── Bhashini Translation & Voice (Phase 6.2, 6.3) ───────────────────
# Register at https://bhashini.gov.in/ as a ULCA participant
BHASHINI_USER_ID=your_bhashini_user_id
BHASHINI_API_KEY=your_bhashini_api_key
BHASHINI_PIPELINE_URL=https://dhruva-api.bhashini.gov.in/services/inference

# ── Google Translate fallback (Phase 6.2) ────────────────────────────
# Enable Cloud Translation API at https://console.cloud.google.com/
GOOGLE_TRANSLATE_API_KEY=your_google_translate_api_key

# ── Firebase Cloud Messaging (Phase 6.7) ─────────────────────────────
# Create project at https://console.firebase.google.com/
# Download service account JSON from Project Settings > Service Accounts
# Set this to the file path OR the raw JSON string
FIREBASE_SERVICE_ACCOUNT_JSON=path/to/firebase-service-account.json

# ── File storage (Phase 6.9) ─────────────────────────────────────────
# Optional — defaults to local uploads/ directory for hackathon build
# For production, use Supabase Storage or S3-compatible bucket
FILE_STORAGE_BUCKET_URL=
FILE_STORAGE_ACCESS_KEY=